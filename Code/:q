using ll = long long;

#define forn(i,n) for(int i=0 ;i<int(n);i++)
#define forsn(i,s,n) for(int i=int(s);i<int(n);i++)

#define all(v) (v).begin(),(v).end()
#define sz(v) (int)(v).size()

const int N = 3e5 + 5;
const int MOD = 998244353;
ll dp[N];
vector<int> G[N];

int add (int a, int b){
	return (a + 0ll + b)%MOD;
}

int mul (int a, int b){
	return (a *1ll* b)%MOD;
}

int binpow(ll b,ll e){
	ll ret = 1;
	while(e > 0){
		if( e&1){
			ret = ret * b %MOD;
		}
		b = b * b%MOD;
		e >>= 1;
	}
	return ret;
}

void dfs(int nod,int fa){
	dp[nod] = 1;
	int v1 = 1;
	int v2 = 1;
	for(auto to : G[nod])if(to != fa){
		dfs(to, nod);
		v1 = mul(v1, dp[to]);
	}
	dp[nod] = add(dp[nod] , v1);
}

